# ================================
# Artifact Data Dashboard (.env)
#
# 规则：
# - 仅需维护仓库根目录的 `.env`（本文件为模板 `.env.example`）。
# - docker compose 会通过 `env_file: ./.env` 将变量注入到容器。
# - 任何敏感值请只保留在本机/CI secrets，切勿提交 `.env`。
# ================================

# Runtime profile
APP_ENV=development
NODE_ENV=development

# Backend HTTP
PORT=3000
TRUST_PROXY=1

# ----------------
# MySQL (container + app)
# ----------------
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=artifact_dashboard
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ----------------
# Neo4j (container + app)
# ----------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_URI=bolt://neo4j:7687

# ----------------
# Redis (container + app)
# ----------------
REDIS_PASSWORD=password
REDIS_HOST=redis
REDIS_PORT=6379

# ----------------
# Auth / JWT
# ----------------
# 生产/类生产环境请务必替换为足够长的随机字符串
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=24h

# ----------------
# AI / MCP
# ----------------
# 推荐：在 Docker 网络内直连 ollama 服务（backend 容器内可解析服务名 "ollama"）
# 说明：优先使用 OpenAI 兼容端点；若你本地 Ollama 不支持该路由，后端会自动降级到 /api/chat。
AI_API_ENDPOINT=http://ollama:11434/v1/chat/completions
# Ollama 默认不校验 key，但后端会把该值当作“已配置”标志。
# 这里给一个非敏感占位符即可（也可以留空，后端会在 ollama 端点场景自动放行）。
AI_API_KEY=local-ollama-placeholder
AI_MODEL=deepseek-r1:8b
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1200
# MCP Neo4j sidecar (docker-compose 服务 artifact-dashboard-neo4j-cypher)
NEO4J_MCP_ENDPOINT=http://neo4j-cypher:8080

# AI Plugins (config-driven, takes effect after backend restart)
# 默认读取 backend/config/ai-plugins.json；如需自定义路径可设置此变量
AI_PLUGINS_CONFIG=

# ----------------
# Uploads
# ----------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# ----------------
# Frontend (CRA)
# ----------------
# 推荐留空：使用同源请求（dev: CRA proxy；prod: nginx 反向代理 /api）
# 如需跨域直连后端，可填写例如：http://localhost:3000
REACT_APP_API_URL=
