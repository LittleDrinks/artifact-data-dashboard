# AI API — Chat Q&A (OpenAI-compatible)
AI_API_KEY=
AI_API_BASE=
AI_MODEL_NAME=

# AI API — LightRAG index build & query (OpenAI-compatible)
LIGHTRAG_API_KEY=
LIGHTRAG_API_BASE=
LIGHTRAG_MODEL_NAME=

# Neo4j (overridden by docker-compose for container networking)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Admin default password (required, min 8 chars)
ADMIN_DEFAULT_PASSWORD=change-me-in-production

# JWT (auto-generated if left empty)
JWT_SECRET_KEY=
