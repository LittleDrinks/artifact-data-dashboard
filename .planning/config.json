{
  "workflow": "gsd",
  "project_type": "brownfield",
  "team_size": 4,
  "auto_mode": true,
  "preferences": {
    "plan_approval": "skip_for_p0",
    "test_strategy": "pytest_e2e_first",
    "git_workflow": "github_flow_light",
    "commit_style": "conventional_chinese",
    "model_selection": {
      "default": "sonnet",
      "complex": "opus",
      "simple": "haiku"
    }
  },
  "environment": {
    "os": "win32",
    "docker_location": "wsl",
    "python_version": "3.12",
    "node_version": "20",
    "backend_port": 8000,
    "frontend_port": 5173
  },
  "flags": {
    "skip_docker_desktop": true,
    "windows_encoding_utf8": true,
    "local_dev_direct": true,
    "production_docker_required": true
  }
}
