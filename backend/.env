# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Secret
JWT_SECRET=artifact-dashboard-secret-key-2023
JWT_EXPIRATION=24h

# MySQL Database Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DATABASE=artifact_dashboard

# Neo4j Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password

# AI Service Configuration (Ollama - DeepSeek-R1)
# 注意：如果在 Docker 中运行，请使用 http://host.docker.internal:11434/v1/chat/completions
AI_API_ENDPOINT=http://host.docker.internal:11434/v1/chat/completions
AI_API_KEY=ollama
AI_MODEL=deepseek-r1:7b
# MCP_MODEL_ID=gpt-4-turbo
# SIMULATION_MODE=true
