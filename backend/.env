# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Secret
JWT_SECRET=artifact-dashboard-secret-key-2023
JWT_EXPIRATION=24h

# MySQL Database Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DATABASE=artifact_dashboard

# Neo4j Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Service Configuration (MCP model)
AI_API_ENDPOINT=https://api.modelcontextprotocol.ai/v1/chat/completions
AI_API_KEY=your_api_key_here
MCP_MODEL_ID=gpt-4-turbo
SIMULATION_MODE=true
