# 服务器配置
PORT=3000
NODE_ENV=development

# 说明：
# - 本文件默认用于 Docker Compose（容器内互联），所以 HOST 使用服务名（mysql/neo4j/redis）
# - 如需在本机直接运行 backend（非 Docker），请将 HOST 改为 localhost，并使用宿主机映射端口：
#   - MySQL: 13306
#   - Neo4j: 17687(bolt) / 17474(http)
#   - Redis: 16379

# MySQL 配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=artifact_dashboard

# Neo4j 配置
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password

# AI / MCP 大模型配置
# 未配置时后端将回退到模拟模式（见 backend/src/services/mcp.service.js）
AI_API_ENDPOINT=
AI_API_KEY=
AI_MODEL=deepseek-r1
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1200

# JWT 配置
JWT_SECRET=your-secret-key-should-be-long-and-secure
JWT_EXPIRES_IN=24h

# 日志配置
LOG_LEVEL=info

# 附件上传配置（Attachments）
# UPLOAD_DIR 可使用绝对路径，或相对 backend 工作目录的相对路径（Docker 中建议挂载为 volume）
UPLOAD_DIR=uploads
# 单个文件最大体积（MB）
MAX_UPLOAD_SIZE_MB=20
