# AI API — Chat Q&A (OpenAI-compatible)
AI_API_KEY=
AI_API_BASE=
AI_MODEL_NAME=

# AI API — LightRAG index build & query (OpenAI-compatible)
LIGHTRAG_API_KEY=
LIGHTRAG_API_BASE=
LIGHTRAG_MODEL_NAME=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# JWT (auto-generated if left empty)
JWT_SECRET_KEY=

# Development overrides (production must set these explicitly)
DEBUG=false
ADMIN_DEFAULT_PASSWORD=

# Rate limiting
RATE_LIMIT_ENABLED=true

# CORS origins — JSON array of allowed frontend domains
# Production: set your actual frontend domain(s)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
